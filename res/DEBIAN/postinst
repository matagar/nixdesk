#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/nixdesk/nixdesk /usr/bin/nixdesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/nixdesk.service ]; then
			rm -f /etc/systemd/system/nixdesk.service /usr/lib/systemd/system/nixdesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/nixdesk/files/systemd/nixdesk.service /usr/lib/systemd/system/nixdesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload nixdesk.service: Unit nixdesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/nixdesk.service:10: Executable path is not absolute: pkill -f "nixdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/nixdesk.service
		fi
		systemctl daemon-reload
		systemctl enable nixdesk
		systemctl start nixdesk
	fi
fi
