#!/bin/bash

set -e

case $1 in
    remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/nixdesk
		
		if [ "systemd" == "${INITSYS}" ]; then

			systemctl stop nixdesk || true
			systemctl disable nixdesk || true
			rm /etc/systemd/system/nixdesk.service /usr/lib/systemd/system/nixdesk.service || true
		fi
        ;;
esac

exit 0
